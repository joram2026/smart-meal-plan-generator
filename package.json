{
  "name": "smart-meal-plan-generator",
  "version": "1.0.0",
  "description": "Smart Meal Plan Generator static server",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node -e \"const fs=require('fs'),path=require('path');function copyDir(s,d){if(!fs.existsSync(d))fs.mkdirSync(d,{recursive:true});for(const item of fs.readdirSync(s)){const sp=path.join(s,item),dp=path.join(d,item);if(fs.statSync(sp).isDirectory())copyDir(sp,dp);else fs.copyFileSync(sp,dp);}}if(fs.existsSync('FRONTEND'))copyDir('FRONTEND','public');\"",
    "lint": "echo 'No lint step needed'"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.5",
    "serverless-http": "^4.0.0"
  }
}
