{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "App user accounts and roles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "phone": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "meal_plans": {
      "title": "Meal Plan",
      "description": "User daily or weekly meal plans",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "days": { "type": "array" },
        "created_at": { "type": "string" }
      },
      "required": ["user_id", "title"]
    },
    "goals": {
      "title": "Health Goal",
      "description": "User health targets and progress",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "target": { "type": "number" },
        "current": { "type": "number" },
        "unit": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["user_id", "title"]
    },
    "water_logs": {
      "title": "Water Intake Log",
      "description": "Water tracking records",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "amount_ml": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["user_id", "amount_ml"]
    },
    "shopping_lists": {
      "title": "Shopping List",
      "description": "Grocery items list",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "title": { "type": "string" },
        "items": { "type": "array" },
        "created_at": { "type": "string" }
      },
      "required": ["user_id", "title"]
    },
    "appointments": {
      "title": "Professional Appointment",
      "description": "Consultation appointments",
      "type": "object",
      "properties": {
        "client_name": { "type": "string" },
        "professional_name": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "status": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["date"]
    },
    "reports": {
      "title": "Nutritional Report",
      "description": "Client progress reports",
      "type": "object",
      "properties": {
        "client_name": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["title"]
    },
    "recipes": {
      "title": "Recipe Catalog",
      "description": "Kenyan and international healthy recipes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "cook_time": { "type": "string" },
        "prep_time": { "type": "string" },
        "servings": { "type": "number" },
        "difficulty": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "string" },
        "carbs": { "type": "string" },
        "fats": { "type": "string" },
        "cost": { "type": "string" },
        "desc": { "type": "string" },
        "img": { "type": "string" },
        "ingredients": { "type": "array" },
        "instructions": { "type": "array" },
        "created_at": { "type": "string" }
      },
      "required": ["name", "ingredients"]
    },
    "foods": {
      "title": "Kenyan Food Dataset",
      "description": "Nutritional database of Kenyan ingredients and foods",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "calories_100g": { "type": "number" },
        "carbs_g": { "type": "number" },
        "protein_g": { "type": "number" },
        "fats_g": { "type": "number" },
        "fiber_g": { "type": "number" },
        "iron_mg": { "type": "number" },
        "vitamin_c_mg": { "type": "number" },
        "glycemic_index": { "type": "string" }
      },
      "required": ["name"]
    },
    "audit_logs": {
      "title": "Audit Log",
      "description": "Security and activity logs",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "user": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action"]
    },
    "support_tickets": {
      "title": "Support Ticket",
      "description": "User help requests and admin support communications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_name": { "type": "string" },
        "user_email": { "type": "string" },
        "user_role": { "type": "string" },
        "subject": { "type": "string" },
        "category": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "created_at": { "type": "string" },
        "replies": { "type": "array" }
      },
      "required": ["user_email", "subject", "message"]
    },
    "notifications": {
      "title": "User Notification",
      "description": "System alerts, support replies, and broadcast announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user_email": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["title", "message"]
    },
    "broadcasts": {
      "title": "System Broadcast Notice",
      "description": "Global admin announcements to all app users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["title", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User accounts and profiles"
    },
    "/meal_plans/{planId}": {
      "schema": "meal_plans",
      "description": "User meal plans"
    },
    "/goals/{goalId}": {
      "schema": "goals",
      "description": "User health goals"
    },
    "/water_logs/{logId}": {
      "schema": "water_logs",
      "description": "Water intake logs"
    },
    "/shopping_lists/{listId}": {
      "schema": "shopping_lists",
      "description": "User shopping lists"
    },
    "/appointments/{appointmentId}": {
      "schema": "appointments",
      "description": "Nutritionist appointments"
    },
    "/reports/{reportId}": {
      "schema": "reports",
      "description": "Client reports"
    },
    "/recipes/{recipeId}": {
      "schema": "recipes",
      "description": "Healthy recipes catalog"
    },
    "/foods/{foodId}": {
      "schema": "foods",
      "description": "Kenyan foods and nutritional dataset catalog"
    },
    "/support_tickets/{ticketId}": {
      "schema": "support_tickets",
      "description": "User and professional support tickets"
    },
    "/notifications/{notifId}": {
      "schema": "notifications",
      "description": "User notification alerts"
    },
    "/broadcasts/{broadcastId}": {
      "schema": "broadcasts",
      "description": "System broadcast announcements"
    }
  }
}
